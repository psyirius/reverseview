/**
* This is a variable font
* You can controll variable axes as shown below:
* font-variation-settings: 'wght' 800.0;
*
* available axes:

* 'wght' (range from 300.0 to 800.0)

*/

@font-face {
    font-family: 'BespokeStencil-Variable';
    src: url('/assets/fonts/BespokeStencil/fonts/BespokeStencil-Variable.woff2') format('woff2'),
    url('/assets/fonts/BespokeStencil/fonts/BespokeStencil-Variable.woff') format('woff'),
    url('/assets/fonts/BespokeStencil/fonts/BespokeStencil-Variable.ttf') format('truetype');
    font-weight: 300 800;
    font-display: swap;
    font-style: normal;
}


