        min-width: 200px;
        border: 1px solid #ccc;
        cursor: pointer;
        position: relative;
    }

    .modern-select .select-header:hover {
        background-color: #f0f0f0;
    }

    .modern-select .select-display {
        display: inline-block;

    }

    .modern-select .select-arrow {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        transition: transform 0.3s ease;
    }
    .modern-select .select-arrow.open{
        transform: translateY(-50%) rotate(180deg);
    }

    .modern-select .select-options {
        position: absolute;
        top: 100%;
        left: 0;
        border: 1px solid #ccc;
        border-top: none;
        background-color: white;
        z-index: 1000;
        width: 100%;
        overflow: auto; !* Added scroll if needed *!
        max-height: 200px; !* Added max height to limit the dropdown *!
    }

    .modern-select .select-option {
        padding: 10px;
        cursor: pointer;
    }

    .modern-select .select-option:hover {
        background-color: #f0f0f0;
    }

    .modern-select .select-option.selected {
        background-color: #e0e0e0;
    }

    !* Semantic UI icon *!
    .modern-select .select-arrow .dropdown.icon {
        display: inline-block;
        width: 1em;
        height: 1em;
