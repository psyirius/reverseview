        }

        .virtual-list-item {
            position: relative; !* Needed for absolute positioning*!
            width: 100%;
            box-sizing: border-box; !*  to be able to have a full width item with borders and padding *!
            border-bottom: 1px solid #eee;
            padding: 10px;
