        line-height: 1;
        margin: 0;
        font-size: 1em; !* Added explicit font-size*!
        font-style: normal;
        font-weight: normal;
        font-family: 'Icons';
        text-align: center;
    }
    .modern-select .select-arrow .dropdown.icon:before {
        content: "\f0d7";
    }*/

