    .data-table-container {
        border: 1px solid #ccc;
        padding: 10px;
        max-height: 300px;
        overflow-y: auto;
        position: relative;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th,
    .data-table td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .data-table th {
        background-color: #f2f2f2;
    }

    .loading-indicator {
        text-align: center;
        font-style: italic;
        color: gray;
    }

    .no-results {
        text-align: center;
        color: red;
        padding: 20px;
        vertical-align: middle;
    }
    .status-message{
        text-align: center;
        padding: 10px;
        color: red;
    }

    .pagination {
        margin-top: 10px;
        text-align: center;
        clear: both;
        display: block;
    }

    .pagination button {
        margin: 0 5px;
        padding: 5px 10px;
    }

    .pagination button[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .rows-per-page-container {
        margin-right: 10px;
        float: left;
        line-height: 20px; /* Align with the page buttons */
    }
    .rows-per-page-container select{
        margin: 0 5px;
    }
    .data-table tbody tr:hover {
        background-color: #f0f0f0;
        cursor: pointer;
    }

    .data-table tbody tr.selected {
        background-color: #d0e9fc;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: block;
        z-index: 10;
    }

    .loading-overlay .loading-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Basic centering without flex */
    }
}

.zui {
    .filterable-table-container {
        width: 100%; /* Adjust as needed */
        border: 1px solid #ccc;
        padding: 0;
        position: relative;
    }

    .filters form {
        padding: 10px;
        background-color: #f0f0f0;
        border-bottom: 1px solid #ddd;
    }
    .filters .filter-group {
        margin-bottom: 5px;
    }

    .filters label {
        display: block;
        margin-bottom: 3px;
        font-weight: bold;
    }

    .filters select {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
    }
    .search-group{
        margin-bottom: 5px;
        position: relative;
    }
    .search-group input[type="text"]{
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
    }
    .clear-search-button {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        border: none;
        background: none;
        font-size: 14px;
        cursor: pointer;
    }
    .buttons-group{
        clear: both;
    }
    .buttons-group .icon-button{
        float: right;
        border: none;
        padding: 5px 10px;
        margin-left: 5px;
        font-size: 18px;
        background-color: transparent;
        cursor: pointer;
    }

    .table-wrapper {
        max-height: 200px; /* Adjust as needed */
        overflow-y: auto;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th,
    .data-table td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .data-table th {
        background-color: #f2f2f2;
    }
    .data-table tbody tr:hover {
        background-color: #f0f0f0;
        cursor: pointer;
    }
    .data-table tbody tr.selected {
        background-color: #d0e9fc;
    }

    .loading-indicator {
        text-align: center;
        font-style: italic;
        color: gray;
    }
    .no-results {
        text-align: center;
        color: red;
        padding: 20px;
        vertical-align: middle;
    }
    .status-message{
        text-align: center;
        padding: 10px;
        color: red;
    }
    .pagination {
        margin-top: 10px;
        text-align: center;
        clear: both;
        display: block;
    }
    .pagination button {
        margin: 0 5px;
        padding: 5px 10px;
    }
    .pagination button[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .rows-per-page-container {
        margin-right: 10px;
        float: left;
        line-height: 20px;
    }
    .rows-per-page-container select{
        margin: 0 5px;
    }
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        z-index: 10;
        display: block;
    }
    .loading-overlay .loading-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Basic centering without flex */
    }
}

