        }
        .pagination button:hover:enabled {
            background-color: #e0e0e0;
            cursor: pointer;
        }
        .pagination span{
            margin: 0 5px;
        }*/
    }

    &.pgl {
        .paginated-list-container {
            width: 100%;
            margin: 0;
            border: 1px solid #e0e0e0;
            background-color: #fff;
            border-radius: 0px;
            overflow: hidden;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }

        .item-list {
            list-style-type: none;
            padding: 0;
            margin: 0;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-box-align: stretch;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }

        .item-list-item {
            padding: 8px 15px; /* Reduced padding here */
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            -webkit-transition: background-color 0.2s ease-in-out;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .item-list-item:last-child {
            border-bottom: none;
        }

        .item-list-item:hover {
            background-color: #f9f9f9;
        }

        .item-list-item.selected {
            @apply bg-blue-100;
            font-weight: 600;
        }

        .pagination-container {
            display: -webkit-box;
            -webkit-box-pack: center;
            padding: 10px 0;
            background-color: #f7f7f7;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }

        .pagination-current-page {
            padding: 8px 12px;
            display: inline-block;
            color: #555;
        }

        .pagination-button {
            display: inline-block;
            padding: 8px 12px;
            margin: 0 4px;
            border: 1px solid #ccc;
            border-radius: 4px;
            background-color: #fff;
            color: #333;
            cursor: pointer;
            -webkit-transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
        }

        .pagination-button:hover {
            background-color: #eee;
        }

        .pagination-button:disabled {
            background-color: #f0f0f0;
            color: #aaa;
            cursor: not-allowed;
        }
    }
}

.swx {
    .flex {
        display: -webkit-box; /* Safari 3.1-6 */
        display: -moz-box; /* Firefox 1.5-26 */
        display: -ms-flexbox; /* IE 10 */
        display: flex;
    }

    .items-center {
        -webkit-box-align: center; /* Safari 3.1-6 */
        -moz-box-align: center; /* Firefox 1.5-26 */
        -ms-flex-align: center; /* IE 10 */
        align-items: center;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .relative {
        position: relative;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .block {
        display: block;
    }
    .bg-gray-200 {
        background-color: #e5e7eb; /* Tailwind gray-200 */
    }
    .bg-white {
        background-color: #fff;
    }
    .w-14 {
        width: 3.5rem; /* Tailwind w-14 */
    }
    .h-8 {
        height: 2rem; /* Tailwind h-8 */
    }
    .w-6 {
        width: 1.5rem; /* Tailwind w-6 */
    }
    .h-6 {
        height: 1.5rem; /* Tailwind h-6 */
    }
    .rounded-full {
        -webkit-border-radius: 9999px; /* Safari */
        -moz-border-radius: 9999px; /* Firefox */
        border-radius: 9999px;
    }

    .absolute {
        position: absolute;
    }
    .top-1 {
        top: 0.25rem; /* Tailwind top-1 */
    }
    .left-1 {
        left: 0.25rem; /* Tailwind left-1 */
    }
    .ml-3 {
        margin-left: 0.75rem; /* Tailwind ml-3 */
    }
    .text-gray-700 {
        color: #374151; /* Tailwind gray-700 */
    }
    .font-medium {
        font-weight: 500;
    }
    .transition-transform { /* This one might not be perfect */
        -webkit-transition-property: -webkit-transform; /* Safari */
        -moz-transition-property: -moz-transform; /* Firefox */
        transition-property: transform;
        -webkit-transition-duration: 150ms;
        -moz-transition-duration: 150ms;
        transition-duration: 150ms;
        -webkit-transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        -moz-transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);

    }
    .transform {
        transform: translate3d(0,0,0); /* Forces acceleration, might not always help in Safari 5 */
    }
    .translate-x-6 {
        -webkit-transform: translateX(1.5rem); /* Tailwind translate-x-6 */
        -moz-transform: translateX(1.5rem); /* Tailwind translate-x-6 */
        transform: translateX(1.5rem);
    }
}

.xyz-dd-sel {
    &.select-dropdown {
        position: relative;
        display: inline-block;

        .select-dropdown-header {
            padding: 8px 10px;
            border: 1px solid #ccc;
            cursor: pointer;
            background-color: #fff;
            min-width: 150px;
            position: relative;
        }

        .select-dropdown-clear {
            cursor: pointer;
            font-size: 1.2em;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            right: 10px;
        }

        .select-dropdown-list-container {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 100;
            background-color: #fff;
            border: 1px solid #ccc;
            max-height: 200px;
            overflow-y: auto;
            width: 100%;
        }
        .select-dropdown-search {
            padding: 5px;
            border-bottom: 1px solid #ccc;
        }
        .select-dropdown-search input {
            width: 100%;
            padding: 5px;
            box-sizing: border-box;
            border: 1px solid #ccc;
        }

        .select-dropdown-list {
            width: 100%;
        }

        .select-dropdown-item {
            padding: 8px 10px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

        .select-dropdown-item:hover {
            background-color: #f0f0f0;
        }

        .select-dropdown-item.selected {
            background-color: #c0e8ff;
            font-weight: bold;
        }
    }
}