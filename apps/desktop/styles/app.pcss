.vxui {
    height: 100%;
    width: 100%;

    .data-table-container {
        width: 100%;
        display: block;
        position: relative; /* Make it a positioning context for loading overlay */
    }

    .data-table-container .search-and-perpage{
        margin-bottom: 10px;
        text-align: right;
    }

    .data-table-container .search-and-perpage label{
        margin-right: 10px;
    }

    .data-table-container table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #ddd;
        table-layout: fixed;
        /* Removed height: 100%;  */
    }

    .data-table-container th,
    .data-table-container td {
        padding: 8px;
        border: 1px solid #ddd;
        text-align: left;
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* Styles for selected row */
    .data-table-container tr.selected {
        background-color: #f0f0f0; /* Light gray background for selection */
    }

    .data-table-container tr:hover {
        background-color: #f9f9f9; /* Slight gray hover for rows */
        cursor: pointer; /* make it appear clickable */
    }

    /* New pagination styles */
    .data-table-container .pagination {
        margin-top: 10px;
        text-align: center;
        display: inline-block; /* to contain buttons */
        width: 100%; /* to align buttons at center */
    }

    .data-table-container .pagination-controls {
        display: inline-block; /* to avoid text align override*/
    }

    .data-table-container .pagination button {
        margin: 2px;
        padding: 5px 10px;
        background-color: #fff;
        border: 1px solid #ccc;
        cursor: pointer;
        border-radius: 3px; /* rounded buttons*/
    }

    .data-table-container .pagination button.active {
        background-color: #ddd;
    }


    .data-table-container .pagination .pagination-info{
        margin-left: 10px;
        font-size: 12px;
        display: inline-block;
    }


    .data-table-container .pagination .page-button-container {
        display: inline-block;
    }


    .data-table-container .pagination .pagination-button-group {
        display: inline-block;
        vertical-align: middle;
    }

    .data-table-container .pagination .pagination-button-group button{
        margin: 2px;
        padding: 5px 10px;
        background-color: #fff;
        border: 1px solid #ccc;
        cursor: pointer;
        border-radius: 3px;
    }


    .data-table-container .pagination .pagination-button-group button.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    /* Loading Overlay */
    .data-table-container .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .data-table-container .loading-spinner {
        font-size: 16px;
    }

    /*Error message*/
    .data-table-container .error-container{
        text-align: center;
        padding: 20px;
    }

    .data-table-container .error-message {
        color: red;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .data-table-container .retry-button{
        background-color: #f0f0f0;
        padding: 5px 10px;
        border: 1px solid #ccc;
        cursor: pointer;
        border-radius: 3px;
    }

    .data-table-container .retry-button:hover{
        background-color: #e0e0e0
    }
}

.xom {
    .multi-select-dropdown {
        position: relative;
        display: inline-block;
    }

    .multi-select-dropdown .dropdown-label{
        display: block;
        margin-bottom: 5px;
        font-size: 14px;
    }

    .multi-select-dropdown .dropdown-header {
        padding: 10px;
        border: 1px solid #ccc;
        cursor: pointer;
        position: relative;
        min-width: 200px;
    }

    .multi-select-dropdown .dropdown-header:hover{
        background-color: #f0f0f0;
    }

    .multi-select-dropdown .dropdown-display{
        display: inline-block;
    }

    .multi-select-dropdown .dropdown-arrow {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        transition: transform 0.3s ease;
    }

    .multi-select-dropdown .dropdown-arrow.open {
        transform: translateY(-50%) rotate(180deg);
    }

    .multi-select-dropdown .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        border: 1px solid #ccc;
        border-top: none;
        background-color: white;
        z-index: 1000;
        width: 100%;
        overflow: auto; /* Added scroll if needed */
        max-height: 200px; /* Added max height to limit the dropdown */
    }

    .multi-select-dropdown .dropdown-option {
        padding: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .multi-select-dropdown .dropdown-option:hover {
        background-color: #f0f0f0;
    }

    .multi-select-dropdown .dropdown-option input[type="checkbox"] {
        margin-right: 5px;
    }

    .multi-select-dropdown .dropdown-option.selected {
        background-color: #e0e0e0;
    }

    /* Semantic UI icon */
    .multi-select-dropdown .dropdown-arrow .dropdown.icon {
        display: inline-block;
        width: 1em;
        height: 1em;
        background: none;
        vertical-align: baseline;
        line-height: 1;
        margin: 0;
        font-size: 1em; /* Added explicit font-size*/
        font-style: normal;
        font-weight: normal;
        font-family: 'Icons';
        text-align: center;
    }
    .multi-select-dropdown .dropdown-arrow .dropdown.icon:before {
        content: "\f0d7";
    }
}

